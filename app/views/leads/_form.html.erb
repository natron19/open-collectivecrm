<% if lead.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% lead.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="row g-3">
  <div class="col-md-6">
    <%= f.label :first_name, class: "form-label" %>
    <%= f.text_field :first_name, class: "form-control", placeholder: "Jordan" %>
  </div>
  <div class="col-md-6">
    <%= f.label :last_name, class: "form-label" %>
    <%= f.text_field :last_name, class: "form-control", placeholder: "Ellis" %>
  </div>
</div>

<div class="row g-3 mt-0">
  <div class="col-md-8">
    <%= f.label :company, class: "form-label" %>
    <%= f.text_field :company, class: "form-control", placeholder: "Acme Corp" %>
  </div>
  <div class="col-md-4">
    <%= f.label :company_size, class: "form-label" %>
    <%= f.select :company_size,
        [["Startup", "startup"], ["Small/Mid-size Business", "smb"], ["Enterprise", "enterprise"]],
        { prompt: "Select size" }, class: "form-select" %>
    <div class="form-text text-muted">This determines how the agent researches your lead's company.</div>
  </div>
</div>

<div class="row g-3 mt-0">
  <div class="col-md-6">
    <%= f.label :role, "Title / Role", class: "form-label" %>
    <%= f.text_field :role, class: "form-control", placeholder: "Head of Growth" %>
  </div>
  <div class="col-md-6">
    <%= f.label :stage, class: "form-label" %>
    <%= f.select :stage,
        Lead::STAGES.map { |s| [s.humanize, s] },
        {}, class: "form-select" %>
  </div>
</div>

<div class="row g-3 mt-0">
  <div class="col-md-6">
    <%= f.label :email, class: "form-label" %>
    <%= f.email_field :email, class: "form-control", placeholder: "jordan@example.com" %>
  </div>
  <div class="col-md-6">
    <%= f.label :website, class: "form-label" %>
    <%= f.url_field :website, class: "form-control", placeholder: "https://example.com" %>
  </div>
</div>

<div class="mt-3">
  <%= f.label :notes, class: "form-label" %>
  <%= f.text_area :notes, rows: 3, class: "form-control",
      placeholder: "Anything relevant about this lead or their company..." %>
</div>
