<div class="row justify-content-center">
  <div class="col-md-10 col-lg-8">
    <div class="d-flex align-items-center mb-4">
      <%= link_to dashboard_path, class: "btn btn-sm btn-outline-secondary me-3" do %>
        &larr; Pipeline
      <% end %>
      <h1 class="h3 mb-0">New Lead</h1>
    </div>

    <div class="card bg-dark border-secondary">
      <div class="card-body p-4">
        <%= form_with model: @lead, url: leads_path do |f| %>
          <%= render "form", f: f, lead: @lead %>
          <div class="mt-4">
            <%= f.submit "Create Lead", class: "btn btn-warning fw-semibold" %>
            <%= link_to "Cancel", dashboard_path, class: "btn btn-outline-secondary ms-2" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
