<%# First-run prompt — shown until seller profile is created %>
<% unless @seller_profile %>
  <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
    <strong>Set up your product context</strong> before generating outreach.
    Your product name and description appear in every email the agent writes.
    <%= link_to "Set it up now →", edit_seller_profile_path, class: "alert-link ms-1" %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">Pipeline</h1>
  <%= link_to "Add Lead", new_lead_path, class: "btn btn-sm btn-warning fw-semibold" %>
</div>

<div class="row g-3 flex-nowrap overflow-auto pb-3">
  <% Lead::STAGES.each do |stage| %>
    <% stage_leads = @leads_by_stage[stage] %>
    <div class="col" style="min-width: 220px; max-width: 280px;">
      <div class="card bg-dark border-secondary d-flex flex-column" style="height: calc(100vh - 200px);">
        <div class="card-header border-secondary d-flex justify-content-between align-items-center py-2">
          <span class="fw-semibold small text-uppercase">
            <%= stage.humanize %>
          </span>
          <span class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill text-bg-secondary"><%= stage_leads.size %></span>
            <%= link_to "+", new_lead_path(stage: stage),
                class: "btn btn-sm btn-outline-warning py-0 px-1 lh-1",
                title: "Add #{stage.humanize} lead" %>
          </span>
        </div>
        <div class="card-body kanban-column p-2 overflow-y-auto flex-grow-1">
          <% if stage_leads.any? %>
            <% stage_leads.each do |lead| %>
              <%= link_to lead_path(lead), class: "text-decoration-none d-block" do %>
                <div class="card mb-2 bg-dark border-secondary lead-card p-2">
                  <div class="fw-semibold small"><%= lead.first_name %> <%= lead.last_name %></div>
                  <div class="small text-muted"><%= lead.company %></div>
                  <% if lead.role.present? %>
                    <div class="small text-muted text-truncate"><%= lead.role %></div>
                  <% end %>
                  <div class="mt-1">
                    <span class="badge rounded-pill small" style="background-color: var(--secondary); font-size: 0.65rem;">
                      <%= lead.company_size %>
                    </span>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <p class="text-muted small text-center mt-3">No leads</p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
