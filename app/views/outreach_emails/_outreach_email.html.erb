<div class="card bg-dark border-secondary mb-3" id="outreach_email_<%= outreach_email.id %>">
  <div class="card-header border-secondary d-flex align-items-center gap-2">
    <span class="badge <%= angle_badge_class(outreach_email.angle) %>">
      <%= outreach_email.angle.humanize %>
    </span>
    <span class="text-muted small ms-auto"><%= outreach_email.created_at.strftime("%b %-d, %Y at %I:%M %p") %></span>
    <%= link_to "Delete", outreach_email_path(outreach_email),
        data: { turbo_method: :delete, turbo_confirm: "Delete this outreach email?" },
        class: "btn btn-sm btn-outline-danger ms-2" %>
  </div>
  <div class="card-body">
    <%# Research summary %>
    <% if outreach_email.research_summary.present? %>
      <div class="mb-3">
        <button class="btn btn-sm btn-outline-secondary mb-2" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#research_<%= outreach_email.id %>">
          What the agent found
        </button>
        <div id="research_<%= outreach_email.id %>" class="collapse show">
          <div class="alert alert-info research-summary mb-0">
            <p class="mb-2 small"><%= outreach_email.research_summary %></p>
            <% if outreach_email.sources.present? %>
              <ul class="mb-0 small">
                <% outreach_email.sources.split("\n").each do |url| %>
                  <% next if url.blank? %>
                  <li><%= link_to url, url, target: "_blank", rel: "noopener" %></li>
                <% end %>
              </ul>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Email content with copy button %>
    <% if outreach_email.subject.present? %>
      <h6 class="text-muted text-uppercase small mb-1">Subject</h6>
      <p class="fw-semibold mb-3"><%= outreach_email.subject %></p>
    <% end %>

    <% if outreach_email.body.present? %>
      <h6 class="text-muted text-uppercase small mb-1">Body</h6>
      <div data-controller="clipboard">
        <pre class="text-wrap bg-body-secondary p-3 rounded small lh-base"
             data-clipboard-target="source"><%= outreach_email.body %></pre>
        <button class="btn btn-sm btn-outline-secondary mb-3"
                data-action="click->clipboard#copy"
                data-clipboard-target="button">Copy</button>
      </div>
    <% end %>

    <%# Raw response toggle %>
    <% if outreach_email.gemini_raw.present? %>
      <button class="btn btn-sm btn-outline-secondary" type="button"
              data-bs-toggle="collapse"
              data-bs-target="#raw_<%= outreach_email.id %>">
        Show raw response
      </button>
      <div id="raw_<%= outreach_email.id %>" class="collapse mt-2">
        <pre class="small text-muted p-3 bg-body-secondary rounded"
             style="max-height: 300px; overflow-y: auto;"><%= outreach_email.gemini_raw %></pre>
      </div>
    <% end %>
  </div>
</div>
