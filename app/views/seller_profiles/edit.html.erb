<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="d-flex align-items-center mb-4">
      <%= link_to dashboard_path, class: "btn btn-sm btn-outline-secondary me-3" do %>
        &larr; Pipeline
      <% end %>
      <h1 class="h3 mb-0">My Profile</h1>
    </div>

    <div class="card bg-dark border-secondary">
      <div class="card-body p-4">
        <p class="text-muted small mb-4">
          This context appears in every outreach email the agent writes for you.
        </p>

        <%= form_with model: @seller_profile, url: seller_profile_path, method: :patch do |f| %>
          <% if @seller_profile.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @seller_profile.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :product_name, "Product Name", class: "form-label" %>
            <%= f.text_field :product_name, class: "form-control", placeholder: "e.g. CollectiveCRM" %>
          </div>

          <div class="mb-4">
            <%= f.label :product_description, "Product Description", class: "form-label" %>
            <%= f.text_area :product_description, rows: 4, class: "form-control",
                placeholder: "Briefly describe what your product does and who it helps. (max 500 characters)" %>
            <div class="form-text text-muted">Max 500 characters.</div>
          </div>

          <%= f.submit "Save Profile", class: "btn btn-warning fw-semibold" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
