# ── App Branding ───────────────────────────────────────────────────────────────
APP_NAME="CollectiveCRM Demo"
APP_TAGLINE="Add a lead. The agent researches their company. AI writes outreach that references something real."
APP_DESCRIPTION="An open source Rails 8 app that shows how an AI agent can research a sales lead and write personalized outreach. Add a lead, choose an angle, and click Generate Outreach. A Gemini agent searches the web and writes an email that opens with a real fact it found."

# ── Database ───────────────────────────────────────────────────────────────────
# DATABASE_URL=postgres://localhost/open_base_development  # optional override

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Web Search (Perplexity) ───────────────────────────────────────────────────
# Used by the outreach agent to research leads.
# Get your key at https://www.perplexity.ai/settings/api
# Without this key the agent falls back to fetch_url only — outreach still generates.
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ── AI Operational Limits ──────────────────────────────────────────────────────
# Set lower than the boilerplate default (50) because each outreach generation
# may consume multiple Gemini calls across the agent loop.
AI_CALLS_PER_USER_PER_DAY=20
AI_GLOBAL_TIMEOUT_SECONDS=15
# Timeout for the multi-turn agent loop (search + fetch + write). Must be higher
# than AI_GLOBAL_TIMEOUT_SECONDS since each round adds latency.
AI_AGENT_TIMEOUT_SECONDS=60
